# Optional — the core app works without these. Copy this file to .env (gitignored) and fill in.

# Cartesia voice (https://play.cartesia.ai -> API keys). Without it the app uses the browser's voice.
CARTESIA_API_KEY=
# Optional: a specific Cartesia voice ID. If empty, the first English voice on your account is used.
CARTESIA_VOICE_ID=
# Optional: TTS model (default sonic-3.6).
CARTESIA_TTS_MODEL=

GEMINI_API_KEY=

# Backend
TOUCHSPACE_DATA_DIR=backend/data
CORS_ORIGINS=http://localhost:5173
