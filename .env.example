# Optional — the core app works without these. Copy this file to .env (gitignored) and fill in.

# Cartesia voice (https://play.cartesia.ai -> API keys). Without it the app uses the browser's voice.
CARTESIA_API_KEY=
# Optional: a specific Cartesia voice ID. If empty, the first English voice on your account is used.
CARTESIA_VOICE_ID=
# Optional: TTS model (default sonic-3.6).
CARTESIA_TTS_MODEL=

# Claude (optional): the web assistant uses ANTHROPIC_API_KEY to interpret free-form questions;
# answers always come from the map. Without the key, the rule parser alone answers.
# Optional: interpreter model (default claude-opus-5-5).
TOUCHSPACE_INTERPRETER_MODEL=

# Backend
TOUCHSPACE_DATA_DIR=backend/data
CORS_ORIGINS=http://localhost:5173

# Native iOS map Q&A: Claude through the Anthropic API (https://console.anthropic.com -> API keys).
# The key is only sent to the Anthropic API. backend/.env is loaded before root .env;
# existing process variables win.
ANTHROPIC_API_KEY=
TOUCHSPACE_LLM_MODEL=claude-opus-5-5
# max_tokens covers Claude's thinking plus tool calls (minimum 4000). Timeout is per request, in seconds.
TOUCHSPACE_LLM_MAX_TOKENS=4000
TOUCHSPACE_LLM_TIMEOUT=30
# Publishing stays disabled until the operator sets a private pairing code.
TOUCHSPACE_PUBLISH_CODE=
# Optional for deployments: >=32 random characters. Otherwise a private signing
# key is generated in backend/data/touchspace/.auth-secret. Preserve that file.
TOUCHSPACE_AUTH_SECRET=

# Optional offline speech for the iOS Simulator. No audio goes to a cloud provider.
# Run backend/scripts/setup_local_speech.sh, then restart the backend.
# Defaults: whisper-cli on PATH; backend/data/speech/ggml-tiny.en.bin.
TOUCHSPACE_WHISPER_CLI=
TOUCHSPACE_WHISPER_MODEL=
