# Optional — the core app works without these. Copy this file to .env (gitignored) and fill in.

# Cartesia voice (https://play.cartesia.ai -> API keys). Without it the app uses the browser's voice.
CARTESIA_API_KEY=
# Optional: a specific Cartesia voice ID. If empty, the first English voice on your account is used.
CARTESIA_VOICE_ID=
# Optional: TTS model (default sonic-3.6).
CARTESIA_TTS_MODEL=

# Gemini (optional): only helps interpret free-form questions; answers always come from the map.
GEMINI_API_KEY=
# Optional: model name (default gemini-3.8-flash).
GEMINI_MODEL=

# Backend
TOUCHSPACE_DATA_DIR=backend/data
CORS_ORIGINS=http://localhost:5173

# Touchspace AI indoor exploration (/api/touchspace)
# Uploads are disabled until this is set to at least 24 random characters.
# Generate locally: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
TOUCHSPACE_UPLOAD_TOKEN=
# Optional hosted conversational intent interpreter; never put this key in iOS.
# Falls back to GEMINI_API_KEY when TOUCHSPACE_GEMINI_API_KEY is empty or not set.
TOUCHSPACE_GEMINI_API_KEY=
TOUCHSPACE_GEMINI_MODEL=gemini-3.8-flash
