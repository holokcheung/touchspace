# Optional — the core app works without these. Copy this file to .env (gitignored) and fill in.

# Cartesia voice (https://play.cartesia.ai -> API keys). Without it the app uses the browser's voice.
CARTESIA_API_KEY=
# Optional: a specific Cartesia voice ID. If empty, the first English voice on your account is used.
CARTESIA_VOICE_ID=
# Optional: TTS model (default sonic-3.6).
CARTESIA_TTS_MODEL=

# Gemini (optional): only helps interpret free-form questions; answers always come from the map.
GEMINI_API_KEY=
# Optional: model name (default gemini-3.8-flash).
GEMINI_MODEL=

# Backend
TOUCHSPACE_DATA_DIR=backend/data
CORS_ORIGINS=http://localhost:5173

# Native iOS map Q&A (Anthropic Messages protocol via OpenRouter).
# backend/.env is loaded before root .env; existing process variables win.
OPENROUTER_API_KEY=
TOUCHSPACE_LLM_MODEL=qwen/qwen3.7-flash
TOUCHSPACE_LLM_MAX_TOKENS=500
TOUCHSPACE_LLM_TIMEOUT=12
# Publishing stays disabled until the operator sets a private pairing code.
TOUCHSPACE_PUBLISH_CODE=
# Optional for deployments: >=32 random characters. Otherwise a private signing
# key is generated in backend/data/touchspace/.auth-secret. Preserve that file.
TOUCHSPACE_AUTH_SECRET=
